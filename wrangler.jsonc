{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cv-ats",
  "account_id": "abbc17e016ed8ea5e70565fce090b5f1",
  "main": "worker-entry.js",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cv-ats-db",
      "database_id": "21455d37-8910-47c8-9be1-b54e2098c239"
    }
  ],
  "vars": {
    "AUTH_TRUST_HOST": "true",
    "NEXTAUTH_URL": "https://draftcv.my.id"
  }
}
